# ================================================================
# MKEKA BOT v3.5 — Environment Variables
# Data: Firecrawl → FlashScore
# AI: Groq (default) or any OpenAI-compatible provider
# ================================================================

# PostgreSQL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/mkeka_bot
DB_SSL=false

# LLM Provider — OpenAI-compatible endpoint
# Default: Groq (https://console.groq.com/keys)
# Alternatives:
#   LLM_BASE_URL=https://api.moonshot.ai/v1        # Kimi
#   LLM_BASE_URL=https://openrouter.ai/api/v1      # OpenRouter
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  # Google AI Studio
LLM_API_KEY=your_llm_api_key_here
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Legacy provider keys (also accepted if LLM_API_KEY is not set)
# GROQ_API_KEY=your_groq_key_here
# KIMI_API_KEY=your_kimi_key_here

# Firecrawl API — MAIN DATA SOURCE
# https://firecrawl.dev → Sign up → Get API key
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Leagues to scan daily (comma-separated)
# Options: championship, league_one, laliga, bundesliga, seriea, ligue1, epl, league_two, segunda
ACTIVE_LEAGUES=championship,league_one,laliga,bundesliga,seriea,ligue1,epl

# Minimum confidence to recommend a bet (0-100)
MIN_CONFIDENCE_TO_BET=65

# App
NEXT_PUBLIC_APP_NAME=MkekaBOT
NODE_ENV=development

# Enable cron jobs (set to 'true' in production)
RUN_CRON=false

# Development data source (off-season)
# - USE_CSV_DATA=true     → load historical matches from data/test.csv (fast, no Firecrawl)
# - USE_SAMPLE_FIXTURES=true → use hardcoded demo matches in lib/devFixtures.js
# - neither               → live Firecrawl scraping
USE_CSV_DATA=true
USE_SAMPLE_FIXTURES=false

# Development AI provider
# - USE_MOCK_AI=true      → deterministic free predictions (no API cost)
# - USE_MOCK_AI=false     → real LLM API calls
USE_MOCK_AI=true

# BetTrack integration (optional)
BETTRACK_API_URL=http://localhost:3001
BETTRACK_API_KEY=your_bettrack_key
